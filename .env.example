# Copy this file to .env (same folder as server.mjs) and fill it in.
# .env is git-ignored. Never commit real keys.

# ── Supabase (optional: cloud backup + evidence photo storage) ───────────────
# Supabase dashboard -> Project Settings -> API
SUPABASE_URL=https://your-project-ref.supabase.co
# The SECRET / service_role key. Server-only: it never reaches the browser.
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_BUCKET=evidence

# ── Secrets (set your own long random values for any real deployment) ──────
# Keys the one-way phone-number hash. Changing it later breaks the
# one-profile-per-phone check for existing players, so set it once.
PHONE_SECRET=
# Keys ghost handles and per-thread aliases.
GHOST_SECRET=

# ── Portals ─────────────────────────────────────────────────────────────────
# Admin dashboard at /admin.html. Off until set (minimum 10 characters).
ADMIN_PASSWORD=
# City Power / SAPS case desk at /partner.html. Off until set (minimum 10 characters).
# Partners can mark reports verified (which pays the reporter) or rejected.
PARTNER_PASSWORD=
